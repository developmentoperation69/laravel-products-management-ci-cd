pipeline {
    agent any

    stages {
        stage('Start') {
            steps {
                echo 'Codomax Laravel Project Pipeline Started'
            }
        }

        stage('Checkout') {
            steps {
                echo 'Project source code checkout successful'
            }
        }

        stage('Build') {
            steps {
                echo 'Laravel project build stage'
            }
        }

        stage('Complete') {
            steps {
                echo 'Codomax CI/CD Pipeline Completed Successfully'
            }
        }
    }
}
